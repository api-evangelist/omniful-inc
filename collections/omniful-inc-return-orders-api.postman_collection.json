          "name": "Create Sales Channel Shipment",
          "request": {
            "name": "Create Sales Channel Shipment",
            "description": {
              "content": "Add Shipment for Return Order This endpoint allows the user to add a shipment for a specific return order belonging to a seller. Request Body tracking_url (string) - The URL for tracking the shipment. awb_number (string) - The Air Waybill (AWB) number for the shipment. awb_label (string) - The URL to the AWB label for the shipment. package_details (object) - Details of the package including number of boxes, weight, dimensions, and remarks. number_of_boxes (integer) - The number of boxes in the s",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sales-channel",
                "public",
                "v1",
                "tenants",
                "sellers",
                ":seller_id",
                "return_orders",
                ":return_order_id",
                "shipment"
              ],
              "host": [
                "{{baseUrl}}"
              ],
