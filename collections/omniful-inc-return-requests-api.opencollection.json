{
  "opencollection": "1.0.0",
  "info": {
    "name": "Omniful Integration APIs Background Jobs Return Requests API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
