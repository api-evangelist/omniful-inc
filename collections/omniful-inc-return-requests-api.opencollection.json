          },
          "http": {
            "method": "PUT",
            "url": "https://prodapi.omniful.com/sales-channel/public/v1/tenants/sellers/:seller_code/return_requests/:return_request_id/reject",
            "params": [
              {
                "name": "seller_code",
                "value": "",
